  "nodes": [
    {
      "id": "domain:knowledge-base-and-schema-governance",
      "type": "domain",
      "name": "Knowledge Base and Schema Governance",
      "summary": "Controls how knowledge bases are created, versioned, validated, and bound to active extraction/query schemas. This domain enforces schema identity immutability and prevents active schemas from being modified destructively.",
      "tags": [
        "schema-management",
        "knowledge-base",
        "validation"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "KnowledgeBase",
          "SchemaDefinition",
          "SchemaDocument"
        ],
        "businessRules": [
          "Schema name and version identify a schema and cannot change after save.",
          "Only inactive schemas can be updated or deleted.",
          "A knowledge base must have an active schema before extraction and query generation."
        ],
        "crossDomainInteractions": [
          "Document processing requires an active schema for graph extraction.",
          "Query generation uses the active schema to constrain generated Cypher."
        ]
      }
    },
    {
      "id": "domain:document-ingestion-and-chunking",
      "type": "domain",
      "name": "Document Ingestion and Chunking",
      "summary": "Handles uploaded source documents, binary storage, parsing, chunking, embedding, and chunk persistence. It turns opaque uploaded files into ordered DocumentChunk nodes suitable for graph extraction and vector indexing.",
      "tags": [
        "documents",
        "chunking",
        "embedding"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "DocumentUpload",
          "DocumentChunk",
          "Embedding"
        ],
        "businessRules": [
          "Duplicate uploads are detected with SHA-256 within a knowledge base.",
          "Processing can be blocked when completed extraction already exists unless overwrite is allowed.",
          "Embedding count must match chunk count."
        ],
        "crossDomainInteractions": [
          "Graph extraction consumes persisted chunks.",
          "Document replacement and deletion clean document-scoped chunks and graph artifacts."
        ]
      }
    },
    {
      "id": "domain:graph-extraction-and-provenance",
      "type": "domain",
      "name": "Graph Extraction and Provenance",
      "summary": "Transforms chunk text into schema-constrained graph entities and relationships, then writes them with provenance back to documents, chunks, schemas, and extraction runs. This domain preserves traceability from extracted facts to source chunks.",
      "tags": [
        "graph-extraction",
        "provenance",
        "schema-constrained"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "ExtractionRun",
          "ExtractedEntity",
          "ExtractedRelation",
          "DocumentChunk"
        ],
        "businessRules": [
          "Extraction only uses labels and relationship types allowed by the active schema.",
          "Extracted nodes and relationships carry source document and source chunk identifiers.",
          "Overwrite cleanup removes obsolete extracted artifacts without deleting infrastructure nodes."
        ],
        "crossDomainInteractions": [
          "Consumes chunks from document processing.",
          "Provides the extracted domain graph queried by the query answering domain."
        ]
      }
    },
    {
      "id": "domain:query-answering",
      "type": "domain",
      "name": "Query Answering",
      "summary": "Converts natural-language questions into read-only Cypher, validates the query against schema and safety rules, and executes it against Neo4j. It currently queries the extracted graph via generated or submitted Cypher rather than automatically running chunk-vector retrieval.",
      "tags": [
        "query",
        "cypher",
        "read-only"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "GeneratedCypher",
          "QueryValidationResult",
          "QueryExecutionResponse"
        ],
        "businessRules": [
          "Only read-only Cypher is allowed.",
          "Generated Cypher must reference active schema labels, relationships, and properties.",
          "LIMIT is injected when required and missing."
        ],
        "crossDomainInteractions": [
          "Uses schema governance for active schema context.",
          "Reads graph facts written by graph extraction and can include chunk provenance when Cypher asks for it."
        ]
      }
    },
    {
      "id": "domain:ai-provider-observability",
      "type": "domain",
      "name": "AI Provider and Observability",
      "summary": "Wraps chat and embedding model interactions with workflow spans, model-call observations, token metadata, and optional privacy-controlled content attributes. This domain supports operational visibility across extraction, embedding, schema generation, and query generation.",
      "tags": [
        "observability",
        "ai-models",
        "tracing"
      ],
      "complexity": "moderate",
      "domainMeta": {
        "entities": [
          "AiWorkflowContext",
          "AiModelCallObservation",
          "AiTokenUsage"
        ],
        "businessRules": [
          "AI content metadata is controlled by configuration.",
          "Model call observations attach workflow and provider profile attributes.",
          "Missing model clients fail fast in workflows that require them."
        ],
        "crossDomainInteractions": [
          "Observes document processing, graph extraction, schema generation, embedding, and query generation flows."
        ]
      }
    },
